# Only fill in Railway Variables or your private local .env; NEVER commit passwords.
STAYOS_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
STAYOS_PLATFORM_DB=/data/platform.sqlite
STAYOS_MEDIA_DIR=/data/media
