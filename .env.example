# Only fill in Railway Variables or your private local .env; NEVER commit passwords.
STAYOS_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
STAYOS_PLATFORM_DB=/data/platform.sqlite
STAYOS_MEDIA_DIR=/data/media
STAYOS_PUBLIC_URL=https://YOUR-APP.up.railway.app
STAYOS_COOKIE_SECURE=1
STAYOS_DEMO_SEED=0
# Optional backup scheduling and offsite S3 destination
STAYOS_AUTO_BACKUP=1
STAYOS_BACKUP_INTERVAL_HOURS=24
STAYOS_ALERT_ESCALATE_MINUTES=3
# STAYOS_BACKUP_S3_BUCKET=YOUR_PRIVATE_BUCKET
# STAYOS_BACKUP_S3_PREFIX=stayos/backups
# AWS_ACCESS_KEY_ID=SET_IN_RAILWAY_ONLY
# AWS_SECRET_ACCESS_KEY=SET_IN_RAILWAY_ONLY
# AWS_DEFAULT_REGION=eu-central-1